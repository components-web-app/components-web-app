# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
DATABASE_URL=postgres://api-platform:CHANGE_ME@db/api_test
# No SMTP relay in the test environment or in CI: mail is built and rendered,
# and Symfony's mailer assertions still see it, but it's never delivered.
# run_test_functional unsets CI's MAILER_DSN so this applies there too.
MAILER_DSN=null://null
