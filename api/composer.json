{
    "name": "components-web-app/component-web-app-api",
    "version": "1.0.0",
    "description": "",
    "license": "MIT",
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "runtime/frankenphp-symfony",
                "version": "1.0.0",
                "require": {
                    "php": ">=7.4",
                    "symfony/dependency-injection": "^5.4 || ^6.0 || ^7.0 || ^8.0",
                    "symfony/http-kernel": "^5.4 || ^6.0 || ^7.0 || ^8.0",
                    "symfony/runtime": "^5.4 || ^6.0 || ^7.0 || ^8.0"
                },
                "autoload": {
                    "psr-4": {
                        "Runtime\\FrankenPhpSymfony\\": "src/"
                    }
                },
                "source": {
                    "type": "git",
                    "url": "https://github.com/php-runtime/frankenphp-symfony.git",
                    "reference": "56822c3631d9522a3136a4c33082d006bdfe4bad"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.5",
        "components-web-app/api-components-bundle": "^2.0@alpha",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "league/flysystem": "^3.0",
        "league/flysystem-google-cloud-storage": "^3.0",
        "runtime/frankenphp-symfony": "^1.0.0",
        "symfony/console": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/flex": "^2.0",
        "symfony/framework-bundle": "^8.1",
        "symfony/mercure-bundle": "^0.5",
        "symfony/monolog-bundle": "^v4.0.2",
        "symfony/runtime": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "justinrainbow/json-schema": "^6.13",
        "phpunit/phpunit": "^13",
        "roave/security-advisories": "dev-latest",
        "symfony/browser-kit": "^8.1",
        "symfony/css-selector": "^8.1",
        "symfony/debug-bundle": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/maker-bundle": "^1.11",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/stopwatch": "^8.1",
        "symfony/web-profiler-bundle": "^8.1"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php56": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php71": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "^8.1"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
