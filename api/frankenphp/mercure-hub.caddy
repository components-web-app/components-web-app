# The hub's settings, imported by php's Caddyfile and by scaled mode's own hub (#85), so both stay identical.
# Named (#113): each SERVER_NAME port gets a copy of this block, and same-named copies share one transport.
name cwa
# Transport to use (default to Bolt)
transport bolt {$MERCURE_TRANSPORT_URL:bolt:///data/mercure.db}
# Must equal the API's `iss` (jwt.claims.iss in mercure.yaml): change both or neither (#110).
issuer cwa {
	publisher {
		jwt {env.MERCURE_PUBLISHER_JWT_KEY} {env.MERCURE_PUBLISHER_JWT_ALG}
	}
	subscriber {
		jwt {env.MERCURE_SUBSCRIBER_JWT_KEY} {env.MERCURE_SUBSCRIBER_JWT_ALG}
	}
}
# Pin `aud` to the public URL: the API publishes through the internal one, so unpinned every publish is 401.
resource_identifier {$MERCURE_PUBLIC_URL:https://localhost/.well-known/mercure}
# Allow anonymous subscribers (double-check that it's what you want)
anonymous
# Enable the subscription API (double-check that it's what you want)
subscriptions
# Extra directives
{$MERCURE_EXTRA_DIRECTIVES}
# Cors origins
cors_origins {$MERCURE_CORS_ORIGIN:*}
