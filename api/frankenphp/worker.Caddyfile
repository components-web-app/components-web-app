# Imported into the global `frankenphp` block (FRANKENPHP_CONFIG in the prod image).

# Shed load (#106): a request that waits this long for a worker gets a 503, not Souin's 10s 504. 0 turns it off.
# FrankenPHP accepts it only here, in the global block, not inside `worker`.
max_wait_time {$FRANKENPHP_MAX_WAIT_TIME:5s}

worker {
	file ./public/index.php
	# A fixed pool: the default follows the node's CPUs (php has no CPU limit), and worst-case memory with it.
	num {$FRANKENPHP_WORKER_NUM:4}
	env APP_RUNTIME Runtime\FrankenPhpSymfony\Runtime
}
