+
+type nopPurgeLogger struct{}
+
+func (nopPurgeLogger) Errorf(string, ...interface{}) {}
+func (nopPurgeLogger) Warnf(string, ...interface{})  {}
+
+type purgeCall struct {
+	tags       []string
+	everything bool
+}
+
+// stubCloudflare records each purge request and answers with the next status
+// in statuses (200 once they run out).
+type stubCloudflare struct {
+	mu       sync.Mutex
+	calls    []purgeCall
+	statuses []int
+}
+
+func (s *stubCloudflare) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	var body struct {
+		Tags            []string `json:"tags"`
+		PurgeEverything bool     `json:"purge_everything"`
+	}
+	b, _ := io.ReadAll(r.Body)
+	_ = json.Unmarshal(b, &body)
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.calls = append(s.calls, purgeCall{tags: body.Tags, everything: body.PurgeEverything})
+	status := http.StatusOK
+	if len(s.statuses) > 0 {
+		status, s.statuses = s.statuses[0], s.statuses[1:]
+	}
+	if status == http.StatusTooManyRequests {
+		w.Header().Set("Retry-After", "7")
+	}
+	w.WriteHeader(status)
+}
+
+// testPurger runs a purger on a fake clock: sleep advances it and is recorded.
+func testPurger(t *testing.T, plan cloudflarePlan, stub *stubCloudflare) (*cloudflarePurger, *[]time.Duration) {
+	srv := httptest.NewServer(stub)
+	t.Cleanup(srv.Close)
+	now := time.Unix(1_700_000_000, 0)
+	sleeps := &[]time.Duration{}
+	p := newCloudflarePurger(
+		float64(plan.requests)/plan.window.Seconds(),
+		float64(plan.burst),
+		func(body []byte) (*http.Request, error) {
+			return http.NewRequest(http.MethodPost, srv.URL, strings.NewReader(string(body)))
+		},
+		nopPurgeLogger{},
+		func() time.Time { return now },
+		func(d time.Duration) {
+			*sleeps = append(*sleeps, d)
+			now = now.Add(d)
+		},
+	)
+
+	return p, sleeps
+}
+
+func drain(p *cloudflarePurger) {
+	for p.sendNext() {
+	}
+}
+
+func tagList(n int) []string {
+	tags := make([]string, n)
+	for i := range tags {
+		tags[i] = fmt.Sprintf("/_api/component/%d", i)
+	}
+	return tags
+}
+
+func TestCloudflarePurger_DeduplicatesAndSendsUpTo100TagsPerRequest(t *testing.T) {
+	stub := &stubCloudflare{}
+	p, _ := testPurger(t, cloudflarePlans["pro"], stub)
+
+	p.purge(tagList(150))
+	p.purge(append(tagList(100), "", "/_api/other", "/_api/other"))
+	drain(p)
+
+	if len(stub.calls) != 2 {
+		t.Fatalf("expected 2 requests, got %d", len(stub.calls))
+	}
+	if len(stub.calls[0].tags) != 100 || len(stub.calls[1].tags) != 51 {
+		t.Errorf("expected 100 + 51 tags, got %d + %d", len(stub.calls[0].tags), len(stub.calls[1].tags))
+	}
+}
+
+func TestCloudflarePurger_WaitsForATokenOnceTheBurstIsUsed(t *testing.T) {
+	stub := &stubCloudflare{}
+	p, sleeps := testPurger(t, cloudflarePlans["free"], stub)
+
+	for i := 0; i < 26; i++ {
+		p.purge([]string{fmt.Sprintf("/_api/page/%d", i)})
+		drain(p)
+	}
+
+	if len(stub.calls) != 26 {
+		t.Fatalf("expected 26 requests, got %d", len(stub.calls))
+	}
+	if len(*sleeps) != 1 || (*sleeps)[0] != 12*time.Second {
+		t.Errorf("expected one 12s wait before the 26th request, got %v", *sleeps)
+	}
+}
+
+func TestCloudflarePurger_CoalescesABacklogIntoOnePurgeEverything(t *testing.T) {
+	stub := &stubCloudflare{}
+	p, _ := testPurger(t, cloudflarePlans["free"], stub)
