+// Cloudflare limits purge requests per account, every kind of purge sharing
+// one allowance, and refuses the rest with a 429. So purges don't go straight
+// out: they are queued, deduplicated and sent by one sender per zone, paced by
+// a token bucket sized for the account's plan. Several pods, or staging and
+// production, sharing an account each get the whole allowance, so set a lower
+// rate for them (CLOUDFLARE_PURGE_REQUESTS / _WINDOW / _BURST).
+// https://developers.cloudflare.com/cache/how-to/purge-cache/
+
+type cloudflarePlan struct {
+	requests int
+	window   time.Duration
+	burst    int
+}
+
+var cloudflarePlans = map[string]cloudflarePlan{
+	"free":       {requests: 5, window: time.Minute, burst: 25},
+	"pro":        {requests: 5, window: time.Second, burst: 25},
+	"business":   {requests: 10, window: time.Second, burst: 50},
+	"enterprise": {requests: 50, window: time.Second, burst: 500},
+}
+
+const (
+	// cloudflareMaxTags is the most tags Cloudflare accepts in one request.
+	cloudflareMaxTags = 100
+	// A backlog the bucket can't send within this window is replaced by one
+	// purge everything: one request, and still correct.
+	cloudflareCoalesceWindow = time.Minute
+	// cloudflareErrorRetry is the least wait before retrying after a network
+	// error or a 5xx.
+	cloudflareErrorRetry = 5 * time.Second
