+func TestCloudflarePurgeLimits(t *testing.T) {
+	cases := []struct {
+		env   map[string]string
+		rate  float64
+		burst float64
+	}{
+		{map[string]string{}, 5.0 / 60, 25},
+		{map[string]string{"CLOUDFLARE_PURGE_PLAN": "Pro"}, 5, 25},
+		{map[string]string{"CLOUDFLARE_PURGE_PLAN": "enterprise"}, 50, 500},
+		{map[string]string{"CLOUDFLARE_PURGE_PLAN": "nope"}, 5.0 / 60, 25},
+		{map[string]string{"CLOUDFLARE_PURGE_PLAN": "business", "CLOUDFLARE_PURGE_REQUESTS": "2", "CLOUDFLARE_PURGE_BURST": "10"}, 2, 10},
+		{map[string]string{"CLOUDFLARE_PURGE_REQUESTS": "3", "CLOUDFLARE_PURGE_WINDOW": "1m"}, 3.0 / 60, 25},
+		{map[string]string{"CLOUDFLARE_PURGE_WINDOW": "soon", "CLOUDFLARE_PURGE_BURST": "-1"}, 5.0 / 60, 25},
+	}
+	for _, c := range cases {
+		rate, burst := cloudflarePurgeLimits(func(k string) string { return c.env[k] }, nopPurgeLogger{})
+		if rate != c.rate || burst != c.burst {
+			t.Errorf("%v: expected %v/s burst %v, got %v/s burst %v", c.env, c.rate, c.burst, rate, burst)
+		}
+	}
+}
+
+func TestRetryAfter(t *testing.T) {
+	now := time.Unix(1_700_000_000, 0)
+	if d := retryAfter("30", now); d != 30*time.Second {
+		t.Errorf("expected 30s, got %s", d)
+	}
+	if d := retryAfter(now.Add(time.Minute).UTC().Format(http.TimeFormat), now); d != time.Minute {
+		t.Errorf("expected 1m, got %s", d)
+	}
+	if d := retryAfter("", now); d != 0 {
+		t.Errorf("expected 0, got %s", d)
+	}
+}
+
+func TestCloudflarePurger_RunSendsQueuedPurgesInTheBackground(t *testing.T) {
+	stub := &stubCloudflare{}
+	srv := httptest.NewServer(stub)
+	t.Cleanup(srv.Close)
+	p := newCloudflarePurger(5, 25, func(body []byte) (*http.Request, error) {
+		return http.NewRequest(http.MethodPost, srv.URL, strings.NewReader(string(body)))
+	}, nopPurgeLogger{}, time.Now, time.Sleep)
+	go p.run()
+
+	p.purge([]string{"/_api/a"})
+	p.purgeEverything()
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		stub.mu.Lock()
+		n := len(stub.calls)
+		stub.mu.Unlock()
+		if n >= 1 {
+			p.mu.Lock()
+			idle := !p.everything && len(p.pending) == 0
+			p.mu.Unlock()
+			if idle {
+				break
+			}
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("the queued purges were never sent")
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+}
