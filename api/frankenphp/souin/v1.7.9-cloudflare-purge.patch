+
+// cloudflarePurgeLimits reads the bucket's rate (requests per second) and burst:
+// CLOUDFLARE_PURGE_PLAN (free, pro, business or enterprise; default free, which
+// is safe on every plan), overridden by CLOUDFLARE_PURGE_REQUESTS per
+// CLOUDFLARE_PURGE_WINDOW (a Go duration) and CLOUDFLARE_PURGE_BURST.
+func cloudflarePurgeLimits(getenv func(string) string, logger purgeLogger) (float64, float64) {
+	plan := cloudflarePlans["free"]
+	if name := strings.ToLower(strings.TrimSpace(getenv("CLOUDFLARE_PURGE_PLAN"))); name != "" {
+		if p, ok := cloudflarePlans[name]; ok {
+			plan = p
+		} else {
+			logger.Errorf("Unknown CLOUDFLARE_PURGE_PLAN %q, using free's purge limits", name)
+		}
+	}
+	if v := strings.TrimSpace(getenv("CLOUDFLARE_PURGE_REQUESTS")); v != "" {
+		if n, err := strconv.Atoi(v); err == nil && n > 0 {
+			plan.requests = n
+		} else {
+			logger.Errorf("Invalid CLOUDFLARE_PURGE_REQUESTS %q, using %d", v, plan.requests)
+		}
+	}
+	if v := strings.TrimSpace(getenv("CLOUDFLARE_PURGE_WINDOW")); v != "" {
+		if d, err := time.ParseDuration(v); err == nil && d > 0 {
+			plan.window = d
+		} else {
+			logger.Errorf("Invalid CLOUDFLARE_PURGE_WINDOW %q, using %s", v, plan.window)
+		}
+	}
+	if v := strings.TrimSpace(getenv("CLOUDFLARE_PURGE_BURST")); v != "" {
+		if n, err := strconv.Atoi(v); err == nil && n > 0 {
+			plan.burst = n
+		} else {
+			logger.Errorf("Invalid CLOUDFLARE_PURGE_BURST %q, using %d", v, plan.burst)
+		}
+	}
+
+	return float64(plan.requests) / plan.window.Seconds(), float64(plan.burst)
+}
+
+func newCloudflarePurger(rate, burst float64, newRequest func([]byte) (*http.Request, error), logger purgeLogger, now func() time.Time, sleep func(time.Duration)) *cloudflarePurger {
+	return &cloudflarePurger{
+		queued:     map[string]struct{}{},
+		wake:       make(chan struct{}, 1),
+		rate:       rate,
+		burst:      burst,
+		tokens:     burst,
+		last:       now(),
+		newRequest: newRequest,
+		client:     purgeClient,
+		logger:     logger,
+		now:        now,
+		sleep:      sleep,
+	}
+}
+
+// purge queues tags and returns at once.
+func (p *cloudflarePurger) purge(tags []string) {
+	p.mu.Lock()
+	added := false
+	if !p.everything {
+		for _, t := range tags {
+			if _, ok := p.queued[t]; t == "" || ok {
+				continue
+			}
+			p.queued[t] = struct{}{}
+			p.pending = append(p.pending, t)
+			added = true
+		}
+	}
+	p.mu.Unlock()
+	if added {
+		p.notify()
+	}
+}
+
+// purgeEverything queues a purge everything, which covers every queued tag.
+func (p *cloudflarePurger) purgeEverything() {
+	p.mu.Lock()
+	p.everything = true
+	p.pending = nil
+	p.queued = map[string]struct{}{}
+	p.mu.Unlock()
+	p.notify()
+}
+
+func (p *cloudflarePurger) notify() {
+	select {
+	case p.wake <- struct{}{}:
+	default:
+	}
+}
+
+func (p *cloudflarePurger) run() {
+	for range p.wake {
+		for p.sendNext() {
+		}
+	}
+}
+
+// refill adds the tokens earned since the last refill. Call with mu held.
+func (p *cloudflarePurger) refill() {
+	now := p.now()
+	p.tokens += now.Sub(p.last).Seconds() * p.rate
+	if p.tokens > p.burst {
+		p.tokens = p.burst
+	}
+	p.last = now
+}
+
+func (p *cloudflarePurger) interval() time.Duration {
+	return time.Duration(float64(time.Second) / p.rate)
+}
+
+// sendNext sends one request when the bucket allows, or waits for a token.
+// It returns false once nothing is queued.
+func (p *cloudflarePurger) sendNext() bool {
+	p.mu.Lock()
+	if !p.everything && len(p.pending) == 0 {
+		p.mu.Unlock()
+		return false
+	}
+	p.refill()
+	if p.tokens < 1 {
+		wait := time.Duration((1 - p.tokens) / p.rate * float64(time.Second))
+		p.mu.Unlock()
+		p.sleep(wait)
+		return true
+	}
+
+	everything := p.everything
+	if !everything {
+		needed := (len(p.pending) + cloudflareMaxTags - 1) / cloudflareMaxTags
+		if float64(needed) > p.tokens+p.rate*cloudflareCoalesceWindow.Seconds() {
+			p.logger.Warnf("Cloudflare purge: %d tags queued, more than the purge limit can send soon, so purging everything instead", len(p.pending))
+			everything = true
+		}
+	}
+	var tags []string
+	if everything {
+		p.everything = false
+		p.pending = nil
+		p.queued = map[string]struct{}{}
+	} else {
+		n := len(p.pending)
+		if n > cloudflareMaxTags {
+			n = cloudflareMaxTags
+		}
+		tags = append([]string(nil), p.pending[:n]...)
+		p.pending = p.pending[n:]
+		for _, t := range tags {
+			delete(p.queued, t)
+		}
+	}
+	p.tokens--
+	p.mu.Unlock()
+
+	if retry, wait := p.send(tags); retry {
+		p.requeue(tags)
+		p.sleep(wait)
+	}
+
+	return true
+}
+
+// requeue puts back a request that failed for a reason worth retrying, ahead
+// of what was queued since. A nil tags means purge everything.
+func (p *cloudflarePurger) requeue(tags []string) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if tags == nil {
+		p.everything = true
+		p.pending = nil
+		p.queued = map[string]struct{}{}
+		return
+	}
+	if p.everything {
+		return
+	}
+	back := make([]string, 0, len(tags)+len(p.pending))
+	for _, t := range tags {
+		if _, ok := p.queued[t]; !ok {
+			p.queued[t] = struct{}{}
+			back = append(back, t)
+		}
+	}
+	p.pending = append(back, p.pending...)
+}
+
+// send makes one purge request (nil tags: purge everything) and says whether
+// to retry it and after how long. A 429, a 5xx or a network error is retried;
+// any other failure, such as a bad token, is logged and dropped.
+func (p *cloudflarePurger) send(tags []string) (bool, time.Duration) {
+	what := "purge everything"
+	body := []byte(`{"purge_everything":true}`)
+	if tags != nil {
+		what = "purge of " + strconv.Itoa(len(tags)) + " tags"
+		body, _ = json.Marshal(map[string]interface{}{"tags": tags})
+	}
+
+	req, err := p.newRequest(body)
+	if err != nil {
+		p.logger.Errorf("Cloudflare %s not sent: %v %v", what, err, tags)
+		return false, 0
+	}
+	res, err := p.client.Do(req)
+	if err != nil {
+		p.logger.Warnf("Cloudflare %s failed, will retry: %v", what, err)
+		return true, p.errorRetry()
+	}
+	b, _ := io.ReadAll(io.LimitReader(res.Body, 4096))
+	_ = res.Body.Close()
+
+	switch {
+	case res.StatusCode == http.StatusOK:
+		return false, 0
+	case res.StatusCode == http.StatusTooManyRequests:
+		wait := retryAfter(res.Header.Get("Retry-After"), p.now())
+		if wait <= 0 {
+			wait = p.interval()
+		}
+		// The account's allowance is used up, whatever this bucket thinks.
+		p.mu.Lock()
+		p.tokens = 0
+		p.last = p.now()
+		p.mu.Unlock()
+		p.logger.Warnf("Cloudflare %s rate limited, will retry in %s", what, wait)
+		return true, wait
+	case res.StatusCode >= 500:
+		p.logger.Warnf("Cloudflare %s failed with status %d, will retry: %s", what, res.StatusCode, b)
+		return true, p.errorRetry()
+	default:
+		p.logger.Errorf("Cloudflare %s failed with status %d: %s %v", what, res.StatusCode, b, tags)
+		return false, 0
+	}
+}
+
+func (p *cloudflarePurger) errorRetry() time.Duration {
+	if i := p.interval(); i > cloudflareErrorRetry {
+		return i
+	}
+	return cloudflareErrorRetry
+}
+
+// retryAfter reads a Retry-After header, in seconds or as an HTTP date.
+func retryAfter(v string, now time.Time) time.Duration {
+	v = strings.TrimSpace(v)
+	if v == "" {
+		return 0
+	}
+	if s, err := strconv.Atoi(v); err == nil {
+		return time.Duration(s) * time.Second
+	}
+	if t, err := http.ParseTime(v); err == nil {
+		return t.Sub(now)
+	}
+	return 0
 }
