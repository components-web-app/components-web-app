diff --git a/pkg/surrogate/providers/common.go b/pkg/surrogate/providers/common.go
index 9f98180..1ff2c6a 100644
--- a/pkg/surrogate/providers/common.go
+++ b/pkg/surrogate/providers/common.go
@@ -343,6 +343,18 @@ func (s *baseStorage) List() map[string]string {
 	return s.Storage.MapKeys(surrogatePrefix)
 }
 
+// Flush method will delete every surrogate key and keep the storage usable.
+// Destruct calls the storer's Reset, which closes most storers (Badger, Nuts,
+// Redis, etcd, Olric), so a full flush must not use it.
+func (s *baseStorage) Flush() error {
+	if s.Storage == nil {
+		return nil
+	}
+	s.Storage.DeleteMany("^" + surrogatePrefix)
+
+	return nil
+}
+
 // Destruct method will shutdown properly the provider
 func (s *baseStorage) Destruct() error {
 	return s.Storage.Reset()
