{
  "version": "1.0",
  "repo": "components-web-app/components-web-app",
  "branch": "main",
  "alwaysExclude": [
    "CLAUDE.md",
    "CHANGELOG.md",
    "packages/",
    "cwa-manifest.json",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    ".github/assets/",
    ".github/ISSUE_TEMPLATE/",
    ".github/pull_request_template.md",
    ".github/workflows/publish-create-cwa.yml",
    ".github/workflows/publish-php-base.yml",
    ".github/workflows/create-cwa-smoke.yml",
    ".github/php-base/",
    ".gitlab/ci/template-only.yml",
    "app/app/pages/login.vue",
    "bin/test/manifest-features.php"
  ],
  "questions": [
    {
      "id": "projectName",
      "type": "text",
      "message": "Project name?",
      "placeholder": "my-cwa-app"
    },
    {
      "id": "ci",
      "type": "select",
      "message": "Where will the pipeline run?",
      "hint": "it builds, tests and deploys the site; choose None to set one up later",
      "choices": [
        {
          "value": "github",
          "label": "GitHub Actions"
        },
        {
          "value": "gitlab",
          "label": "GitLab CI"
        },
        {
          "value": "none",
          "label": "None yet"
        }
      ]
    },
    {
      "id": "deploy",
      "type": "select",
      "message": "Deploy to?",
      "choices": [
        {
          "value": "kubernetes",
          "label": "A Kubernetes cluster",
          "hint": "Helm; review apps, staging and production"
        },
        {
          "value": "server",
          "label": "One server with Docker",
          "hint": "preview: the pipeline deploys over SSH; set CWA_CI_SERVER_HOST"
        }
      ]
    },
    {
      "id": "features",
      "type": "multiselect",
      "message": "Which components do you want to build pages with?",
      "choices": [
        {
          "value": "navigation",
          "label": "Navigation menu",
          "hint": "links in the site header",
          "selected": true
        },
        {
          "value": "html-content",
          "label": "Rich text",
          "hint": "headings, lists and links, edited in place (TipTap)",
          "selected": true
        },
        {
          "value": "image",
          "label": "Images",
          "hint": "upload and place pictures; stored locally in dev, set up storage when you deploy",
          "selected": true
        },
        {
          "value": "blog",
          "label": "Blog",
          "requires": [
            "html-content",
            "image"
          ],
          "hint": "an article list with search, and an article page template"
        },
        {
          "value": "nested-pages",
          "label": "Nested pages",
          "requires": [
            "html-content"
          ],
          "hint": "topics with chapter sub-pages"
        },
        {
          "value": "forms",
          "label": "Example form",
          "hint": "a form with every field type, to copy from"
        }
      ],
      "hint": "you can delete any of them later"
    },
    {
      "id": "content",
      "type": "select",
      "message": "Start with example pages?",
      "hint": "edit or delete them in the admin later",
      "default": "demo",
      "choices": [
        {
          "value": "demo",
          "label": "A home page plus an example of each component"
        },
        {
          "value": "home",
          "label": "Just a home page"
        },
        {
          "value": "empty",
          "label": "An empty site",
          "hint": "only the admin login"
        }
      ]
    }
  ],
  "features": {
    "navigation": {
      "exclude": [
        "api/src/Entity/NavigationLink.php",
        "app/app/cwa/components/NavigationLink/",
        "api/src/DataFixtures/Parts/NavigationScaffoldPart.php"
      ]
    },
    "html-content": {
      "exclude": [
        "api/src/Entity/HtmlContent.php",
        "app/app/cwa/components/HtmlContent/",
        "app/app/components/TipTap/",
        "app/app/components/TipTapHtmlEditor.vue",
        "api/src/DataFixtures/Parts/HtmlContentScaffoldPart.php"
      ]
    },
    "image": {
      "exclude": [
        "api/src/Entity/Image.php",
        "app/app/cwa/components/Image/",
        "api/src/DataFixtures/Parts/ImageScaffoldPart.php",
        "api/tests/Functional/ImageTest.php"
      ]
    },
    "blog": {
      "requires": [
        "html-content",
        "image"
      ],
      "exclude": [
        "api/src/Entity/BlogArticleData.php",
        "api/config/serializer/BlogArticleData.yaml",
        "app/app/cwa/components/Collection/",
        "app/app/components/CollectionImage.vue",
        "app/app/components/CollectionPagination.vue",
        "app/app/components/CollectionSearch.vue",
        "api/src/DataFixtures/Parts/BlogScaffoldPart.php"
      ]
    },
    "nested-pages": {
      "requires": [
        "html-content"
      ],
      "exclude": [
        "api/src/Entity/NestedPageData.php",
        "api/src/DataFixtures/Parts/NestedPagesScaffoldPart.php"
      ]
    },
    "forms": {
      "exclude": [
        "app/app/cwa/components/ExampleForm/",
        "api/src/Form/",
        "api/src/DataFixtures/Parts/FormsScaffoldPart.php"
      ]
    }
  },
  "ci": {
    "github": {
      "exclude": [
        ".gitlab-ci.yml"
      ]
    },
    "gitlab": {
      "exclude": [
        ".github/",
        "bin/devops/github-export-vars.sh",
        "bin/devops/github-export-secrets.sh"
      ]
    },
    "none": {
      "exclude": [
        ".github/",
        ".gitlab-ci.yml",
        "bin/devops/"
      ]
    }
  },
  "content": {
    "demo": {
      "exclude": []
    },
    "home": {
      "exclude": [
        "api/src/DataFixtures/Parts/BlogScaffoldPart.php",
        "api/src/DataFixtures/Parts/FormsScaffoldPart.php",
        "api/src/DataFixtures/Parts/HtmlContentScaffoldPart.php",
        "api/src/DataFixtures/Parts/ImageScaffoldPart.php",
        "api/src/DataFixtures/Parts/NavigationScaffoldPart.php",
        "api/src/DataFixtures/Parts/NestedPagesScaffoldPart.php"
      ]
    },
    "empty": {
      "exclude": [
        "api/src/DataFixtures/AppScaffold.php",
        "api/src/DataFixtures/Parts/"
      ]
    }
  }
}
